# AlphaiStore Environment Variables

This file contains example environment variables for the AlphaiStore project.
Copy this file to `.env.local` and fill in your actual values.

# Frontend Configuration
NEXT_PUBLIC_API_ENDPOINT=http://localhost:5000/api # Local development only; use the Render URL in Vercel
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name # Replace with your Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset # Replace with your Cloudinary upload preset

# Backend Configuration (if running locally, these might be in backend/.env.local)
MONGODB_URI=mongodb://localhost:27017/alphai_store # Replace with your MongoDB connection string
JWT_SECRET=your_jwt_secret_key # Replace with a strong, secret key
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NODE_ENV=development

# Other configurations
PORT=3000 # Port for the Next.js frontend
BACKEND_PORT=5000 # Port for the Express backend
# Payment Gateway Keys etc. would go here if applicable
